+// ── Motard patch: JavaScript user-defined SQL functions ─────────────────────────────────────────────────────────
+// A UDF runs while a synchronous execute* call is on the stack, i.e. on the JS thread, so it may call back into JS.
+// Calls from the async thread pool are refused with an SQL error instead of touching the runtime.
+namespace motard_udf {
+constexpr int64_t kMaxSafe = 9007199254740991LL;
+
+struct Udf {
+  jsi::Runtime *rt;
+  std::thread::id thread;
+  std::shared_ptr<jsi::Value> fn;
+  std::shared_ptr<jsi::Value> start;
+  std::shared_ptr<jsi::Value> step;
+  std::shared_ptr<jsi::Value> result;
+  std::unordered_map<int64_t, std::shared_ptr<jsi::Value>> states;
+  int64_t next_id = 0;
+};
+
+inline jsi::Value to_js(jsi::Runtime &rt, sqlite3_value *v) {
+  switch (sqlite3_value_type(v)) {
+  case SQLITE_INTEGER: {
+    int64_t n = sqlite3_value_int64(v);
+    if (n > kMaxSafe || n < -kMaxSafe) {
+      return jsi::BigInt::fromInt64(rt, n);
+    }
+    return jsi::Value(static_cast<double>(n));
+  }
+  case SQLITE_FLOAT:
+    return jsi::Value(sqlite3_value_double(v));
+  case SQLITE_TEXT: {
+    const unsigned char *text = sqlite3_value_text(v);
+    int len = sqlite3_value_bytes(v);
+    return jsi::String::createFromUtf8(rt, text, static_cast<size_t>(len));
+  }
+  default:
+    return jsi::Value::null();
+  }
+}
+
+inline void set_result(jsi::Runtime &rt, sqlite3_context *ctx, const jsi::Value &r) {
+  if (r.isNull() || r.isUndefined()) {
+    sqlite3_result_null(ctx);
+  } else if (r.isBool()) {
+    sqlite3_result_int(ctx, r.getBool() ? 1 : 0);
+  } else if (r.isBigInt()) {
+    sqlite3_result_int64(ctx, r.getBigInt(rt).asInt64(rt));
+  } else if (r.isNumber()) {
+    double d = r.getNumber();
+    if (d == static_cast<double>(static_cast<int64_t>(d)) && d >= -9.2e18 && d <= 9.2e18) {
+      sqlite3_result_int64(ctx, static_cast<int64_t>(d));
+    } else {
+      sqlite3_result_double(ctx, d);
+    }
+  } else if (r.isString()) {
+    std::string text = r.getString(rt).utf8(rt);
+    sqlite3_result_text(ctx, text.c_str(), static_cast<int>(text.size()), SQLITE_TRANSIENT);
+  } else {
+    sqlite3_result_error(ctx, "motard udf: unsupported result type", -1);
+  }
+}
+
+inline bool on_js_thread(sqlite3_context *ctx, Udf *u) {
+  if (std::this_thread::get_id() == u->thread) return true;
+  sqlite3_result_error(ctx, "motard udf: called off the JS thread (use the synchronous execute API)", -1);
+  return false;
+}
+
+inline void fail(sqlite3_context *ctx, const char *what) {
+  sqlite3_result_error(ctx, what, -1);
+}
+
+inline void call_scalar(sqlite3_context *ctx, int argc, sqlite3_value **argv) {
+  auto *u = static_cast<Udf *>(sqlite3_user_data(ctx));
+  if (!on_js_thread(ctx, u)) return;
+  try {
+    jsi::Runtime &rt = *u->rt;
+    std::vector<jsi::Value> args;
+    args.reserve(argc);
+    for (int i = 0; i < argc; i++) args.push_back(to_js(rt, argv[i]));
+    jsi::Value r = u->fn->asObject(rt).asFunction(rt).call(rt, static_cast<const jsi::Value *>(args.data()), args.size());
+    set_result(rt, ctx, r);
+  } catch (const jsi::JSError &e) {
+    fail(ctx, e.getMessage().c_str());
+  } catch (const std::exception &e) {
+    fail(ctx, e.what());
+  }
+}
+
+inline int64_t *agg_slot(sqlite3_context *ctx) {
+  return static_cast<int64_t *>(sqlite3_aggregate_context(ctx, sizeof(int64_t)));
+}
+
+inline void agg_step(sqlite3_context *ctx, int argc, sqlite3_value **argv) {
+  auto *u = static_cast<Udf *>(sqlite3_user_data(ctx));
+  if (!on_js_thread(ctx, u)) return;
+  try {
+    jsi::Runtime &rt = *u->rt;
+    int64_t *slot = agg_slot(ctx);
+    if (slot == nullptr) { sqlite3_result_error_nomem(ctx); return; }
+    if (*slot == 0) {
+      *slot = ++u->next_id;
+      jsi::Value initial = u->start->asObject(rt).asFunction(rt).call(rt);
+      u->states[*slot] = std::make_shared<jsi::Value>(rt, initial);
+    }
+    std::vector<jsi::Value> args;
+    args.reserve(static_cast<size_t>(argc) + 1);
+    args.emplace_back(rt, *u->states[*slot]);
+    for (int i = 0; i < argc; i++) args.push_back(to_js(rt, argv[i]));
+    jsi::Value next = u->step->asObject(rt).asFunction(rt).call(rt, static_cast<const jsi::Value *>(args.data()), args.size());
+    u->states[*slot] = std::make_shared<jsi::Value>(rt, next);
+  } catch (const jsi::JSError &e) {
+    fail(ctx, e.getMessage().c_str());
+  } catch (const std::exception &e) {
+    fail(ctx, e.what());
+  }
+}
+
+inline void agg_final(sqlite3_context *ctx) {
+  auto *u = static_cast<Udf *>(sqlite3_user_data(ctx));
+  if (!on_js_thread(ctx, u)) return;
+  try {
+    jsi::Runtime &rt = *u->rt;
+    int64_t *slot = static_cast<int64_t *>(sqlite3_aggregate_context(ctx, 0));
+    jsi::Value state = jsi::Value::undefined();
+    if (slot != nullptr && *slot != 0) {
+      auto it = u->states.find(*slot);
+      if (it != u->states.end()) {
+        state = jsi::Value(rt, *it->second);
+        u->states.erase(it);
+      }
+    } else {
+      state = u->start->asObject(rt).asFunction(rt).call(rt);
+    }
+    jsi::Value r = u->result->asObject(rt).asFunction(rt).call(rt, state);
+    set_result(rt, ctx, r);
+  } catch (const jsi::JSError &e) {
+    fail(ctx, e.getMessage().c_str());
+  } catch (const std::exception &e) {
+    fail(ctx, e.what());
+  }
+}
+
+inline void destroy(void *p) { delete static_cast<Udf *>(p); }
+} // namespace motard_udf
