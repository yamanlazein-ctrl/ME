{
  "version": 5,
  "description": "Hard release gate — every path required by desktop preflight_check() plus packaging-critical peers (SQLite-only desktop: no PostgreSQL artefact may be present). Relative to desktop/src-tauri/resources/. Optional sha256 (64 hex) is verified when present.",
  "required": [
    {
      "path": "node.exe",
      "kind": "file"
    },
    {
      "path": "server/server.mjs",
      "kind": "file"
    },
    {
      "path": "server/pino-worker.cjs",
      "kind": "file"
    },
    {
      "path": "server/thread-stream-worker.cjs",
      "kind": "file"
    },
    {
      "path": "server/web/_shell.html",
      "kind": "file"
    },
    {
      "path": "server/web/index.html",
      "kind": "file"
    },
    {
      "path": "server/node_modules/@node-rs/argon2-win32-x64-msvc",
      "kind": "dir"
    },
    {
      "path": "server/node_modules/better-sqlite3/package.json",
      "kind": "file"
    },
    {
      "path": "server/node_modules/better-sqlite3/lib/index.js",
      "kind": "file"
    },
    {
      "path": "server/node_modules/better-sqlite3/prebuilds/win32-x64.node",
      "kind": "file"
    },
    {
      "path": "server/sqlite-migrations/meta/_journal.json",
      "kind": "file"
    },
    {
      "path": "server/sqlite-migrations/meta/schema-fingerprint.json",
      "kind": "file"
    },
    {
      "path": "server/sqlite-migrations/0000_baseline.sql",
      "kind": "file"
    },
    {
      "path": "license-public.pem",
      "kind": "file"
    },
    {
      "path": "server/desktop-seed.json",
      "kind": "file"
    }
  ]
}
