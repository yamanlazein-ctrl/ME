{
  "version": 3,
  "description": "Hard release gate — every path required by desktop preflight_check() plus packaging-critical peers. Relative to desktop/src-tauri/resources/. Optional sha256 (64 hex) is verified when present.",
  "required": [
    { "path": "postgres/bin/postgres.exe", "kind": "file" },
    { "path": "postgres/bin/pg_ctl.exe", "kind": "file" },
    { "path": "postgres/bin/initdb.exe", "kind": "file" },
    { "path": "postgres/bin/pg_dump.exe", "kind": "file" },
    { "path": "postgres/bin/pg_restore.exe", "kind": "file" },
    { "path": "postgres/bin/libpq.dll", "kind": "file" },
    { "path": "postgres/pgdata-template/PG_VERSION", "kind": "file" },
    { "path": "postgres/pgdata-template.manifest.json", "kind": "file" },
    { "path": "node.exe", "kind": "file" },
    { "path": "server/server.mjs", "kind": "file" },
    { "path": "server/pino-worker.cjs", "kind": "file" },
    { "path": "server/thread-stream-worker.cjs", "kind": "file" },
    { "path": "server/web/_shell.html", "kind": "file" },
    { "path": "server/migrations/meta/_journal.json", "kind": "file" },
    { "path": "server/node_modules/@node-rs/argon2-win32-x64-msvc", "kind": "dir" },
    { "path": "license-public.pem", "kind": "file" }
  ]
}
