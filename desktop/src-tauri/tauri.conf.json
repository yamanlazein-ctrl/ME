{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motard Fabrics Group ERP",
  "version": "1.1.0",
  "identifier": "com.motardfabrics.erp",
  "build": {
    "frontendDist": "../shell",
    "beforeBuildCommand": "cmd /c src-tauri\\before-build.cmd"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Motard ERP",
        "url": "splash.html",
        "width": 420,
        "height": 320,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/postgres": "postgres",
      "resources/node.exe": "node.exe",
      "resources/server": "server",
      "resources/license-public.pem": "license-public.pem"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QzhCQTU2RDdDMzIzQTEKUldTaEk4UFhWcnJJaE1vNVJGMnlyWWlya2NtcVhXSVlqWStkNGNJa2J2cE1MNXdTMUFtOW5PNnAK",
      "endpoints": [
        "https://updates.motardfabrics.com/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
