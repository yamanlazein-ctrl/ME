{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window loads the embedded SPA from Tauri's own asset protocol. Its only transport permission is `api`, the bridge to the bundled sidecar over a named pipe — the app has no HTTP origin of its own.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-fingerprint",
    "allow-validate-license",
    "allow-ensure-document-folders",
    "allow-archive-document-pdf",
    "allow-get-hub-url",
    "allow-set-hub-url",
    "allow-request-factory-reset",
    "allow-apply-factory-reset-now",
    "allow-get-app-version",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "allow-api",
    "allow-get-data-root",
    "allow-save-backup-file"
  ]
}
