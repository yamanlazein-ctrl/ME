<?xml version="1.0" encoding="UTF-8"?>
<!--
  wix-cleanup.wxs — INTENTIONAL uninstall behavior (documented, do not "fix").

  On a TRUE uninstall (REMOVE="ALL", not an upgrade) this deletes the entire
  per-user data root:

      %LOCALAPPDATA%\motard-erp\   (live pgdata + logs + secrets.dat + device-binding.dat)

  Why: test/dev databases (erp_e2e*, erp_wizard_test*, …) and stale logs otherwise
  survive uninstalls and get silently reused by the next install, causing
  confusing "old build" test cycles. For the current TEST phase a full wipe is
  the required behavior.

  ⚠️ FUTURE REAL-CUSTOMER WARNING: for a production customer this same step
  would DESTROY their live database. Before shipping to a real customer, either
  gate this behind an opt-in (e.g. a checkbox "delete my data", or a
  MOTARD_WIPEDATA=1 property) or remove it and ship a separate "factory reset"
  tool. See desktop/BUILD-WINDOWS.md § "Uninstall data policy".

  Safety properties of this action:
  - Runs only on true uninstall (condition REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE),
    never on install / repair / major upgrade.
  - Impersonate="yes": runs as the installing user, so %LOCALAPPDATA% resolves
    to THAT user's folder even when uninstall runs elevated.
  - Return="ignore": a locked file can never fail the uninstall itself.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <CustomAction Id="CleanupMotardAppData"
                  Directory="TARGETDIR"
                  ExeCommand='cmd /c rmdir /s /q "%LOCALAPPDATA%\motard-erp"'
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CleanupMotardAppData" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
