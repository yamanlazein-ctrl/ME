# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# Optional
VITE_API_TIMEOUT_MS=15000

# Repository mode: "api" is the only supported mode (Phase 0 Option A decision).
# "inmemory" is deprecated and will be removed.
VITE_REPO_MODE=api

# Optional default tenant used by the login form and auth context fallback.
# Set this to the UUID of the tenant created during setup/seed; leave blank to require selection.
VITE_DEFAULT_TENANT_ID=

# Supabase (optional — for future use)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Browser Use Cloud (optional — coding agents / hosted browser automation)
# Create a key at https://cloud.browser-use.com/settings?tab=api-keys&new=1
BROWSER_USE_API_KEY=
