# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# Optional
VITE_API_TIMEOUT_MS=15000

# Repository mode: "api" is the only supported mode (Phase 0 Option A decision).
# "inmemory" is deprecated and will be removed.
VITE_REPO_MODE=api

# Default tenant used by the login form and auth context fallback.
# Set this to the UUID of the tenant created during setup/seed.
VITE_DEFAULT_TENANT_ID=407fccfc-ba89-41c5-b5b9-ddb2c4f385d9

# Supabase (optional — for future use)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
