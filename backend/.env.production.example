# Production compose example for a central ERP server
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=erp

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
APP_MASTER_KEY=replace-with-base64-32-byte-key
SETUP_TOKEN=replace-with-random-bootstrap-token

# Generate once via: npm run license:genkey -- --write
LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Comma-separated browser origins allowed to call the API directly.
# For desktop sync rollout, replace with the real remote desktop/web origins.
CORS_ORIGIN=https://erp.example.com

RATE_LIMIT_RPS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Optional: peer desktop nodes push outbox here when set on those nodes.
# CENTRAL_SYNC_URL=

# Optional
SENTRY_DSN=
FX_UPSTREAM_URL=https://lirascope.syria-cloud.sy/api/v1/rates/latest?currencies=USD&lang=ar
FX_REFRESH_INTERVAL_MS=900000
FX_FETCH_TIMEOUT_MS=8000
