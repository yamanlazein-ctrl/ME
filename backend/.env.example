# Backend environment (copy to .env and fill in real values)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRY_MS=1800000
REFRESH_TOKEN_EXPIRY_MS=31536000000
# CORS allowlist — COMMA-SEPARATED list of allowed browser origins.
# Parsed into an array by `corsOrigins` in src/infrastructure/config/env.ts and
# applied by BOTH servers (ERP :8080 and License Server :8081).
#   5173 = ERP frontend (vite dev)
#   5174 = license admin dashboard (admin-dashboard/, vite dev)
# The dashboard normally reaches :8081 through its own Vite proxy (same-origin,
# see admin-dashboard/vite.config.ts), so listing 5174 here is defence-in-depth
# for direct API calls that bypass the proxy (scripts, manual tests).
# In production: serve the dashboard behind a reverse proxy that forwards
# /license-admin and /v1, OR set VITE_LICENSE_SERVER_URL and add that origin
# here. See R-01 in REMEDIATION_LOG.md.
# `*` is rejected at boot when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174
RATE_LIMIT_RPS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# ── FX reference rate (header display-only widget — never billing logic) ──
# The backend fetches this URL on a timer into an in-memory cache; browsers
# only call GET /api/fx/reference-rate. Defaults shown.
FX_UPSTREAM_URL=https://lirascope.syria-cloud.sy/api/v1/rates/latest?currencies=USD&lang=ar
FX_REFRESH_INTERVAL_MS=900000
FX_FETCH_TIMEOUT_MS=8000

# Optional: central sync hub for multi-device desktop peers (phase 4+).
# Leave unset for local-only operation. Example: https://erp.example.com
# CENTRAL_SYNC_URL=https://erp.example.com

# ── License signing keypair (Ed25519) — REQUIRED in production ──
# Offline license tokens are signed with EdDSA. If LICENSE_SIGNING_KEY is
# unset, BOTH entrypoints (ERP :8080 and License Server :8081) mint an
# EPHEMERAL keypair at boot, so every restart silently invalidates every
# token issued before it — an install activated yesterday stops verifying.
# NODE_ENV=production refuses to boot without it (see env.ts).
#
# Generate ONCE and keep it:
#   cd backend && npm run license:genkey -- --write
#
# Multi-line PEMs are stored on one line with escaped newlines (\n); the
# signer restores real newlines. LICENSE_SIGNING_PUBLIC_KEY is OPTIONAL —
# it is derived from the private key when absent. A verify-only install
# (separate License Server holds the private key) sets ONLY the public key.
# NEVER rotate these casually: it invalidates all issued offline tokens.
# LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# LICENSE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
