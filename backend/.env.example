# Backend environment (copy to .env and fill in real values)
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRY_MS=1800000
REFRESH_TOKEN_EXPIRY_MS=2592000000
# CORS allowlist — COMMA-SEPARATED list of allowed browser origins.
# Parsed into an array by `corsOrigins` in src/infrastructure/config/env.ts and
# applied by BOTH servers (ERP :8080 and License Server :8081).
#   5173 = ERP frontend (vite dev)
#   5174 = license admin dashboard (admin-dashboard/, vite dev)
# The dashboard normally reaches :8081 through its own Vite proxy (same-origin,
# see admin-dashboard/vite.config.ts), so listing 5174 here is defence-in-depth
# for direct API calls that bypass the proxy (scripts, manual tests).
# In production: serve the dashboard behind a reverse proxy that forwards
# /license-admin and /v1, OR set VITE_LICENSE_SERVER_URL and add that origin
# here. See R-01 in REMEDIATION_LOG.md.
# `*` is rejected at boot when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_RPS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# ── FX reference rate (header display-only widget — never billing logic) ──
# The backend fetches this URL on a timer into an in-memory cache; browsers
# only call GET /api/fx/reference-rate. Defaults shown.
FX_UPSTREAM_URL=https://liranews.info/api/public/v1/price/usdsypd
FX_REFRESH_INTERVAL_MS=900000
FX_FETCH_TIMEOUT_MS=8000
