# Backend environment (copy to .env and fill in real values)
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRY_MS=1800000
REFRESH_TOKEN_EXPIRY_MS=2592000000
CORS_ORIGIN=*
RATE_LIMIT_RPS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
