# Backend environment (copy to .env and fill in real values)
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRY_MS=1800000
REFRESH_TOKEN_EXPIRY_MS=2592000000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_RPS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# ── FX reference rate (header display-only widget — never billing logic) ──
# The backend fetches this URL on a timer into an in-memory cache; browsers
# only call GET /api/fx/reference-rate. Defaults shown.
FX_UPSTREAM_URL=https://liranews.info/api/public/v1/price/usdsypd
FX_REFRESH_INTERVAL_MS=900000
FX_FETCH_TIMEOUT_MS=8000
